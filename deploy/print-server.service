[Unit]
Description=UP-DR200 web print server
After=network-online.target cups.service
Wants=network-online.target
# User unit; starts at boot when deploy enables linger + systemctl --user enable.

[Service]
Type=simple
WorkingDirectory=%h/print-server
Environment=PYTHONUNBUFFERED=1
Environment=PRINT_SERVER_PRINTER=UP-DR200
Environment=PRINT_SERVER_HOST=0.0.0.0
Environment=PRINT_SERVER_PORT=8080
ExecStart=%h/print-server/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8080
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
